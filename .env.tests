NODE_ENV=test
UNCHAINED_DISABLE_EMAIL_INTERCEPTION=1
MOCK_APIS=1

# ROOT_URL is set dynamically by tests/setup.js to match the actual server port
# The gridfs adapter reads ROOT_URL at runtime, not at module load time
EMAIL_WEBSITE_NAME=Unchained
EMAIL_FROM=noreply@unchained.local
EMAIL_WEBSITE_URL=http://localhost:4010
UNCHAINED_TOKEN_SECRET=random-token-that-is-not-secret-at-all
UNCHAINED_COOKIE_DOMAIN=localhost
UNCHAINED_SECRET=secret
UNCHAINED_GRIDFS_PUT_UPLOAD_SECRET=secret

# Plugin secrets
DATATRANS_SECRET=secret
DATATRANS_SIGN_KEY=1337
APPLE_IAP_SHARED_SECRET=71c41914012b4ad7be859f6c26432298
CRYPTOPAY_SECRET=secret
CRYPTOPAY_BTC_XPUB=zpub6qpRm6gMdkrXvVKw7qgayHnqJGJkpE4rnYQdyJfZW87ed4Fk6HjVaThN12hv2rrL3EzfvvBW6ZpbMEe5UxZYEjhgeMigyvAbS5LiXPkKrys
CRYPTOPAY_ETH_XPUB=xpub6DTksA6DsGUgbEp1U29v3qGTt5P99iKThaqGEzerTfD73ZAg1F8j15TxWTPEjjA1uw1Zmwwc5dgVCXwTL2ZNhvdoLWNdqVuL1MDJMsQCLLs
SAFERPAY_CUSTOMER_ID=274656
SAFERPAY_USER=API_274656_19972312
PAYREXX_SECRET=secret
STRIPE_SECRET=
STRIPE_ENDPOINT_SECRET=
STRIPE_WEBHOOK_ENVIRONMENT=

# ACP (Agentic Commerce Protocol) — enables the ACP plugin routes for integration tests.
# The provider below is inserted by tests/plugins-acp.test.js. The ACP SPT *charge* needs
# real Stripe credentials; hermetic tests exercise the (adapter-agnostic) session lifecycle
# only, so the provider points at the already-registered cryptopay GENERIC adapter. Both
# keys are allowlisted so the production default (stripe) stays documented.
UNCHAINED_ACP_API_KEY=test-acp-secret-key
UNCHAINED_ACP_PAYMENT_PROVIDER_ID=acp-test-provider
ACP_PAYMENT_ADAPTER_KEYS=shop.unchained.payment.stripe,shop.unchained.payment.cryptopay
ACP_PAYMENT_MERCHANT_ID=test-merchant
ACP_CHECKOUT_CONTINUE_URL=https://shop.test.example/orders
ACP_SELLER_NAME=Test Shop
ACP_SELLER_URL=https://shop.test.example
ACP_SELLER_PRIVACY_POLICY=https://shop.test.example/privacy
ACP_SELLER_TOS=https://shop.test.example/terms
ACP_PRODUCT_URL_BASE=https://shop.test.example/products
ACP_TARGET_COUNTRIES=CH
