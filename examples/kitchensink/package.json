{
  "name": "@unchainedshop/example-kitchensink",
  "description": "Kitchensink for Unchained Engine (Fastify)",
  "private": true,
  "version": "5.0.0-alpha.13",
  "license": "EUPL-1.2",
  "type": "module",
  "homepage": "https://unchained.shop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unchainedshop/unchained.git"
  },
  "contributors": [
    "Vedran Rudelj <vedran@unchained.shop> (https://unchained.shop)",
    "Pascal Kaufmann <pascal@unchained.shop> (https://unchained.shop)",
    "Marco Wettstein <maw@panter.ch>",
    "Simon Emanuel Schmid <simon@unchained.shop> (https://unchained.shop)",
    "Mikael Araya Mengistu <mikaeln@unchained.shop> (https://unchained.shop)"
  ],
  "bugs": {
    "url": "https://github.com/unchainedshop/unchained/issues"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=26.12.1",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "lint": "prettier -w .",
    "clean": "tsc -b --clean",
    "build": "tsc -b",
    "start": "node --no-warnings --env-file=.env.defaults --env-file-if-exists=.env --import ./load_env.js lib/boot.js",
    "predev": "npm run build:plugin",
    "dev": "run-p dev:server dev:plugin",
    "dev:server": "node --no-warnings --env-file=.env.defaults --env-file-if-exists=.env --import ./load_env.js --watch src/boot.ts",
    "dev:plugin": "npm --prefix plugins/bookmark-manager run build:watch",
    "build:plugin": "npm --prefix plugins/bookmark-manager install --no-audit --no-fund && npm --prefix plugins/bookmark-manager run build",
    "integration-test": "node --no-warnings --env-file=.env.defaults --env-file ../../.env.tests --env-file-if-exists=../../.env --import ./load_env.js --watch src/boot.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.47",
    "@modelcontextprotocol/server": "^2.0.0",
    "@scure/bip32": "^2.0.0",
    "@scure/btc-signer": "^2.0.0",
    "@unchainedshop/admin-ui": "^5.0.0-alpha.13",
    "@unchainedshop/api": "^5.0.0-alpha.13",
    "@unchainedshop/core": "^5.0.0-alpha.13",
    "@unchainedshop/core-delivery": "^5.0.0-alpha.13",
    "@unchainedshop/core-payment": "^5.0.0-alpha.13",
    "@unchainedshop/platform": "^5.0.0-alpha.13",
    "@unchainedshop/plugins": "^5.0.0-alpha.13",
    "fastify": "^5.4.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "nodemailer": "^10.0.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "mongodb-memory-server": "^11.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
