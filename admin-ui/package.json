{
  "name": "@unchainedshop/admin-ui",
  "license": "EUPL-1.2",
  "version": "4.8.33",
  "description": "Unchained Commerce Admin UI Template",
  "main": "./out/index.html",
  "files": [
    "dist",
    "out"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "next dev",
    "build": "node ./generate-permissions.js && NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "eslint --fix .",
    "extract-translation": "formatjs extract 'src/(pages|modules|components)/**/*.{ts,tsx,jsx}' --out-file src/lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "compile-translation": "formatjs compile  ./src/lang/en.json  --out-file ./src/i18n/en.json --format custom-formatter.js && node extract-missing-translation-keys.js",
    "serve": "npx serve out",
    "cy:run": "cypress run",
    "cy:open": "cypress run",
    "test:e2e": "cypress run",
    "test:component": "cypress open --component",
    "test:e2e-record": "cypress run --browser chrome --record",
    "version:patch": "npm version patch && npm run tag",
    "version:minor": "npm version minor && npm run tag",
    "version:major": "npm version major && npm run tag",
    "tag": "git push --follow-tags",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "npm": ">=10.0.0"
  },
  "contributors": [
    "Vedran Rudelj <vedran@unchained.shop> (http://www.unchained.shop)",
    "Pascal Kaufmann <pascal@unchained.shop> (http://www.unchained.shop)",
    "Mikael Araya Mengistu <mikael@unchained.shop> (http://www.unchained.shop)"
  ],
  "devDependencies": {
    "@ai-sdk/react": "^4.0.146",
    "@apollo/client": "^4.3.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.34",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@formatjs/intl-relativetimeformat": "^12.3.15",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@next/eslint-plugin-next": "^16.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "ai": "^7.0.73",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cypress": "^16.2.0",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "deepmerge": "^4.3.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-formatjs": "^8.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "formik": "^2.4.9",
    "globals": "^17.13.0",
    "graphql": "^17.0.2",
    "intl-messageformat": "^12.1.2",
    "lodash.isequal": "^4.5.0",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "npm-run-all": "^4.1.5",
    "papaparse": "^5.7.0",
    "prettier": "^3.9.10",
    "react": "19.3",
    "react-dom": "19.3",
    "react-intl": "^12.1.4",
    "react-is": "19.3",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^6.0.3",
    "validator": "^13.15.35"
  }
}
