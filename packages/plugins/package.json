    "@unchainedshop/core-warehousing": "^5.0.0-alpha.7",
    "@unchainedshop/core-worker": "^5.0.0-alpha.7",
    "@unchainedshop/events": "^5.0.0-alpha.7",
    "@unchainedshop/logger": "^5.0.0-alpha.7",
    "@unchainedshop/mongodb": "^5.0.0-alpha.7",
    "@unchainedshop/roles": "^5.0.0-alpha.7",
    "@unchainedshop/utils": "^5.0.0-alpha.7"
  },
  "peerDependencies": {
