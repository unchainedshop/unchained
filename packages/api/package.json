{
  "name": "@unchainedshop/api",
  "description": "GraphQL API layer for the Unchained Engine with Express/Fastify adapters and MCP server",
  "version": "4.8.32",
  "main": "lib/api-index.js",
  "types": "lib/api-index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./lib/api-index.js",
      "types": "./lib/api-index.d.ts"
    },
    "./fastify": {
      "import": "./lib/fastify/index.js",
      "types": "./lib/fastify/index.d.ts"
    },
    "./express": {
      "import": "./lib/express/index.js",
      "types": "./lib/express/index.d.ts"
    },
    "./lib/*": {
      "import": "./lib/*",
      "types": "./lib/*"
    },
    "./lib/*.js": {
      "import": "./lib/*.js",
      "types": "./lib/*.d.ts"
    },
    "./index.html": {
      "import": "./index.html"
    }
  },
  "scripts": {
    "clean": "tsc -b --clean",
    "build": "tsc -b",
    "prepublishOnly": "npm run clean && npm run build",
    "watch": "tsc -w",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unchainedshop/unchained.git"
  },
  "keywords": [
    "unchained",
    "ecommerce",
    "api"
  ],
  "authors": [
    "Pascal Kaufmann",
    "Mikael Araya",
    "Vedran Rudelj",
    "Joël Meiller"
  ],
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/unchainedshop/unchained/issues"
  },
  "homepage": "https://github.com/unchainedshop/unchained#readme",
  "peerDependencies": {
    "@ai-sdk/mcp": "^2.0.29",
    "@fastify/cookie": ">= 11 < 12",
    "@fastify/multipart": ">= 9 < 11",
    "@fastify/session": ">= 11 < 12",
    "@fastify/static": ">= 10.1.3 < 11",
    "@modelcontextprotocol/server": ">= 2 < 3",
    "ai": ">= 7 < 8",
    "express": ">= 5 < 6",
    "express-session": ">= 1.18 < 2",
    "fastify": ">= 5.2 < 6",
    "graphql": ">= 16.14 < 18",
    "graphql-yoga": "^5.24.6",
    "mongodb": ">= 7 < 8",
    "multer": ">= 2.3 < 3",
    "passport": ">= 0.7 < 1"
  },
  "peerDependenciesMeta": {
    "graphql": {
      "optional": false
    },
    "graphql-yoga": {
      "optional": false
    },
    "express-session": {
      "optional": false
    },
    "mongodb": {
      "optional": false
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@ai-sdk/mcp": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@fastify/cookie": {
      "optional": true
    },
    "@fastify/multipart": {
      "optional": true
    },
    "@fastify/session": {
      "optional": true
    },
    "@fastify/static": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "multer": {
      "optional": true
    },
    "passport": {
      "optional": true
    }
  },
  "dependencies": {
    "@envelop/core": "^5.6.1",
    "@unchainedshop/core": "^4.8.31",
    "@unchainedshop/core-assortments": "^4.8.31",
    "@unchainedshop/core-bookmarks": "^4.8.31",
    "@unchainedshop/core-countries": "^4.8.31",
    "@unchainedshop/core-currencies": "^4.8.31",
    "@unchainedshop/core-delivery": "^4.8.31",
    "@unchainedshop/core-enrollments": "^4.8.31",
    "@unchainedshop/core-events": "^4.8.31",
    "@unchainedshop/core-files": "^4.8.31",
    "@unchainedshop/core-filters": "^4.8.31",
    "@unchainedshop/core-languages": "^4.8.31",
    "@unchainedshop/core-orders": "^4.8.31",
    "@unchainedshop/core-payment": "^4.8.31",
    "@unchainedshop/core-products": "^4.8.31",
    "@unchainedshop/core-quotations": "^4.8.31",
    "@unchainedshop/core-users": "^4.8.31",
    "@unchainedshop/core-warehousing": "^4.8.31",
    "@unchainedshop/core-worker": "^4.8.31",
    "@unchainedshop/events": "^4.8.31",
    "@unchainedshop/logger": "^4.8.31",
    "@unchainedshop/mongodb": "^4.8.31",
    "@unchainedshop/roles": "^4.8.31",
    "@unchainedshop/utils": "^4.8.31",
    "dataloader": "^2.2.3",
    "graphql-scalars": "^2.0.1",
    "mime": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/mcp": "^2.0.34",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/session": "^11.1.4",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.5",
    "ai": "^7.0.73",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "fastify": "^5.12.7",
    "graphql": "^17.0.2",
    "mongodb": "^7.7.0",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "typescript": "^6.0.3"
  }
}
